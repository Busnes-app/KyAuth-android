<?xml version="1.0" encoding="utf-8"?>
<!-- Firebase's manifest surface, merged into play and github only; fdroid has no such class. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- No Firebase installation or token until the user pairs over FCM: see PushTokenProvider. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <service
            android:name=".mfa.KyAuthMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
